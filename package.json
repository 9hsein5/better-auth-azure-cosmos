{
  "name": "better-auth-azure-cosmos",
  "version": "0.6.0",
  "description": "Azure Cosmos DB for NoSQL adapter for Better Auth.",
  "license": "MIT",
  "author": "9hsein5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9hsein5/better-auth-azure-cosmos.git"
  },
  "homepage": "https://github.com/9hsein5/better-auth-azure-cosmos#readme",
  "bugs": {
    "url": "https://github.com/9hsein5/better-auth-azure-cosmos/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-adapter",
    "azure",
    "cosmos",
    "cosmosdb",
    "nosql",
    "auth",
    "authentication"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node --test test/package-smoke.mjs",
    "test:watch": "vitest",
    "emulator:up": "docker compose -f test/docker-compose.yml up -d --wait",
    "emulator:down": "docker compose -f test/docker-compose.yml down -v",
    "verify": "npm run typecheck && npm run build && npm run test:package && npm run test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@azure/cosmos": "^4.10.1",
    "better-auth": "^1.7.17"
  },
  "devDependencies": {
    "@azure/cosmos": "^4.10.1",
    "@better-auth/core": "1.7.17",
    "@better-auth/test-utils": "1.7.17",
    "@types/node": "^22.20.5",
    "better-auth": "1.7.17",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
